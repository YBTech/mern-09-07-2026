# Read by every service at startup (node --env-file=otel.env). This is ALL the OpenTelemetry
# configuration there is: services/shared/otel.ts (loaded with --require) does the rest.

# Where to send logs, metrics and traces: the OTel Collector inside the otel-lgtm container.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Push metrics every 5s instead of the default 60s, so dashboards react during a live demo.
OTEL_METRIC_EXPORT_INTERVAL=5000

# Use the current, stable names for HTTP metrics (http.server.request.duration).
OTEL_SEMCONV_STABILITY_OPT_IN=http

# Turn off instrumentations we don't use, so startup stays quiet.
OTEL_NODE_DISABLED_INSTRUMENTATIONS=fs,dns,net

# Only detect local resource info (host, process...). Without this, Node probes cloud metadata
# servers (AWS/GCP/Azure) on startup and prints a warning when it isn't running in a cloud.
OTEL_NODE_RESOURCE_DETECTORS=env,host,os,process,serviceinstance
