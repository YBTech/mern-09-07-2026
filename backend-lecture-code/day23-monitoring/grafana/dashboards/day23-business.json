{
  "uid": "day23-business",
  "title": "Day 23 \u00b7 3 Business",
  "description": "Orders, revenue, payments and stock: the system as the business sees it.",
  "tags": [
    "day23"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "type": "row",
      "title": "Money and orders",
      "collapsed": false,
      "panels": [],
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "stat",
      "title": "Orders placed / minute",
      "description": "Successful checkouts.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "interval": "10s",
      "targets": [
        {
          "expr": "sum(rate(shop_orders_placed_total[1m])) * 60",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Revenue / minute",
      "description": "Value of orders placed.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "interval": "10s",
      "targets": [
        {
          "expr": "sum(rate(shop_orders_revenue_cents_total[1m])) * 60 / 100",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "id": 3,
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Checkouts lost to crashes / minute",
      "description": "POST /orders that ended in a 500: money left on the table. Today that's the pricing bug.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "interval": "10s",
      "targets": [
        {
          "expr": "sum(histogram_count(increase(http_server_request_duration_seconds{service_name=\"orders\",http_route=\"/orders\",http_response_status_code=~\"5..\"}[1m])))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Revenue lost to crashes / minute (estimate)",
      "description": "Crashed checkouts \u00d7 average order value. Why a 'small' bug deserves a fix today.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "interval": "10s",
      "targets": [
        {
          "expr": "sum(histogram_count(increase(http_server_request_duration_seconds{service_name=\"orders\",http_route=\"/orders\",http_response_status_code=~\"5..\"}[1m]))) * (sum(increase(shop_orders_revenue_cents_total[10m])) / sum(increase(shop_orders_placed_total[10m]))) / 100",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "id": 5,
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "timeseries",
      "title": "Orders per minute: placed vs. refused vs. crashed",
      "description": "Refused = a business reason (card declined, out of stock). Crashed = a bug. Different problems, different owners.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(shop_orders_placed_total[1m])) * 60",
          "legendFormat": "placed",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        },
        {
          "expr": "sum by (reason) (rate(shop_orders_rejected_total[1m])) * 60",
          "legendFormat": "refused \u00b7 {{reason}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B"
        },
        {
          "expr": "sum(histogram_count(rate(http_server_request_duration_seconds{service_name=\"orders\",http_route=\"/orders\",http_response_status_code=~\"5..\"}[1m]))) * 60",
          "legendFormat": "crashed (5xx)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C"
        }
      ],
      "interval": "10s",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 6,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "timeseries",
      "title": "Revenue per minute",
