    {
      "type": "timeseries",
      "title": "Charges per second by outcome",
      "description": "Approved vs. declined. A jump in declines can be a provider problem, not a customer one.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(shop_payments_charges_total[1m]))",
