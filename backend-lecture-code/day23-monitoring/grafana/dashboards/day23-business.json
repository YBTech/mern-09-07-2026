    {
      "type": "bargauge",
      "title": "Decline rate",
      "description": "Share of charges the card network refused.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "100 * sum(increase(shop_payments_charges_total{outcome=\"declined\"}[5m])) / sum(increase(shop_payments_charges_total[5m]))",
          "legendFormat": "declined",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
