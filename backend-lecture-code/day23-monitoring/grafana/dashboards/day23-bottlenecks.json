{
  "uid": "day23-bottlenecks",
  "title": "Day 23 \u00b7 2 Bottlenecks",
  "description": "What is running out of capacity? Watch it during npm run load:stress.",
  "tags": [
    "day23"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
