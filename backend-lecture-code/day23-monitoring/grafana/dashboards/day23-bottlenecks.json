    {
      "type": "timeseries",
      "title": "Checkout: orders / second vs. p95 latency (the ceiling)",
      "description": "Throughput (left axis) climbs, then flattens. Latency (right axis) keeps climbing. That bend is the ceiling.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by () (histogram_count(rate(http_server_request_duration_seconds{service_name=\"orders\",http_route=\"/orders\",http_request_method=\"POST\"}[30s])))",
          "legendFormat": "orders / second (left)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by () (rate(http_server_request_duration_seconds{service_name=\"orders\",http_route=\"/orders\",http_request_method=\"POST\"}[1m])))",
          "legendFormat": "p95 latency (right)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B"
        }
      ],
      "interval": "10s",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "p95 latency (right)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "color",
