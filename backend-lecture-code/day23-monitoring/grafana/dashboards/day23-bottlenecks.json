      "targets": [
        {
          "expr": "sum by (span_name) (rate(traces_spanmetrics_latency_sum{span_name=~\"SELECT.*|INSERT.*|UPDATE.*|db.pool.acquire.*|inventory.row-lock.*|payments.queue.*|payment-provider.*|ml-service.*|smtp.*|orders.buildRevenueReport.*\"}[1m]))",
