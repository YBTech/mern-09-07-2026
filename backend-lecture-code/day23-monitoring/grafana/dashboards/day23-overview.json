    {
      "type": "timeseries",
      "title": "Time spent calling each dependency (p95, as seen by the caller)",
      "description": "Caller \u2192 callee. If this is much larger than the callee's own p95, the time is going to queueing or the network.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, client, server) (rate(traces_service_graph_request_client_seconds_bucket[1m])))",
          "legendFormat": "{{client}} \u2192 {{server}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
