  "panels": [
    {
      "type": "row",
      "title": "The four golden signals, for the whole shop (measured at the gateway: what a customer feels)",
      "collapsed": false,
      "panels": [],
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "stat",
      "title": "Traffic: requests / second",
      "description": "Requests the gateway is serving right now.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "interval": "10s",
      "targets": [
        {
          "expr": "sum by () (histogram_count(rate(http_server_request_duration_seconds{service_name=\"gateway\"}[30s])))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Errors: % of requests failing (5xx)",
      "description": "Share of gateway requests that ended in a 5xx. Green below 1%.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "interval": "10s",
      "targets": [
        {
          "expr": "100 * sum(histogram_count(rate(http_server_request_duration_seconds{service_name=\"gateway\",http_response_status_code=~\"5..\"}[1m]))) / sum(histogram_count(rate(http_server_request_duration_seconds{service_name=\"gateway\"}[1m])))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "id": 3,
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Latency: p95 at the gateway",
      "description": "95% of requests finished faster than this.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "interval": "10s",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by () (rate(http_server_request_duration_seconds{service_name=\"gateway\"}[1m])))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 1.5
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
