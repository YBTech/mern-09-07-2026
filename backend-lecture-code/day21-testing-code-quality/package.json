{
  "name": "day21-testing-code-quality",
  "version": "1.0.0",
  "private": true,
  "description": "Day 21 lecture: a tiny shop (2 services + gateway + React) wired with every kind of test",
  "type": "module",
  "scripts": {
    "dev:all": "concurrently --names catalog,orders,gateway,web --prefix-colors auto \"npm run catalog\" \"npm run orders\" \"npm run gateway\" \"npm run web\"",
    "catalog": "tsx watch services/catalog/server.ts",
    "orders": "tsx watch services/orders/server.ts",
    "gateway": "tsx watch services/gateway/server.ts",
    "web": "vite",
    "test": "vitest run --project 'unit:*'",
    "test:watch": "vitest --project 'unit:*'",
    "test:coverage": "vitest run --project 'unit:*' --coverage",
    "test:integration": "vitest run --project integration",
    "test:contract": "PACT_DO_NOT_TRACK=true vitest run --project contract-consumer && PACT_DO_NOT_TRACK=true vitest run --project contract-provider",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:smoke": "playwright test --grep @smoke --max-failures=1",
    "test:regression": "playwright test --grep @regression",
    "test:critical": "playwright test --grep @critical",
    "test:flaky": "SHOW_FLAKY=1 playwright test e2e/flaky.spec.ts --repeat-each=10 --reporter=line",
    "test:flaky:alone": "SHOW_FLAKY=1 playwright test e2e/flaky.spec.ts --grep \"flaky state: reads\" --reporter=line",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "ci": "npm run lint && npm run format:check && npm run typecheck && npm run test:coverage && npm run test:integration && npm run test:contract && npm run test:smoke && npm run test:e2e"
  },
  "dependencies": {
    "express": "^5.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@pact-foundation/pact": "^17.1.4",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "concurrently": "^10.0.5",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
