{
  "name": "day32-pizza-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "dev:v1": "AGENT_VERSION=v1 PORT=3032 tsx watch --env-file=../../.env src/server.ts",
    "dev:v2": "AGENT_VERSION=v2 PORT=3033 tsx watch --env-file=../../.env src/server.ts",
    "reset": "rm -rf runs",
    "typecheck": "tsc --noEmit",
    "eval:code": "tsx --env-file=../../.env evals/01-code-evaluator.ts",
    "eval:decision": "tsx --env-file=../../.env evals/02-decision-model-evaluator.ts",
    "eval:judge": "tsx --env-file=../../.env evals/03-llm-judge-evaluator.ts",
    "eval:node": "tsx --env-file=../../.env evals/04-node-evaluator.ts",
    "eval:all": "npm run eval:code && npm run eval:decision && npm run eval:judge && npm run eval:node",
    "eval:v1": "AGENT_VERSION=v1 npm run eval:all",
    "eval:v2": "AGENT_VERSION=v2 npm run eval:all"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@langchain/anthropic": "^1.5.12",
    "@langchain/classic": "^1.0.53",
    "@langchain/core": "^1.2.18",
    "@langchain/langgraph": "^1.5.1",
    "@langchain/langgraph-checkpoint-sqlite": "^1.1.0",
    "@langchain/textsplitters": "^1.0.2",
    "express": "^5.3.0",
    "langchain": "^1.5.18",
    "langsmith": "^0.11.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
