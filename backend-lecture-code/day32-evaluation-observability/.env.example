# Get a key at https://console.anthropic.com and paste it here. Never commit .env.
ANTHROPIC_API_KEY=

# LangSmith: sign up at https://smith.langchain.com → Settings → API Keys → Create API Key
# Nothing is deployed: your laptop sends traces, feedback and eval results to your LangSmith account.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=slice-pizza-day32
# Only if you signed up in the EU region:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
