{
  "info": {
    "name": "Day 26 \u2014 Bookshop API",
    "description": "The Day 26 lecture project (Express + TypeScript, in memory).\n\n1. `npm install`, then `npm run dev` (http://localhost:3026).\n2. Run the requests in order. **Place an order** saves the new order id into `orderId`, and **Create a book** saves `bookId`.\n3. Data lives in memory: restart the server to reset it.\n\nSeeded books: b1 to b8 (b3 Dune is $10.00 with 20 in stock; b4, b6 and b8 are low stock). Coupons: SAVE10 and FIVEOFF (min $20.00). Money is in cents.\n\nThe last folder holds requests for the tickets: they return errors or 404 until the tickets are built.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3026"
    },
    {
      "key": "adminToken",
      "value": "admin123"
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "bookId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Health and books",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "List books",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": ["{{baseUrl}}"],
              "path": ["books"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"8 seeded books\", () => pm.expect(pm.response.json()).to.have.length(8));"
                ]
              }
            }
          ]
        },
        {
          "name": "Search books (search + genre)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?search=dune&genre=fiction",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                {
                  "key": "search",
                  "value": "dune"
                },
                {
                  "key": "genre",
                  "value": "fiction"
                }
              ]
            },
            "description": "TICKET-104 covers tests for this endpoint: it already works."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Get one book",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/b3",
              "host": ["{{baseUrl}}"],
              "path": ["books", "b3"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"is Dune\", () => pm.expect(pm.response.json().title).to.eql(\"Dune\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get a book that does not exist (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/nope",
              "host": ["{{baseUrl}}"],
              "path": ["books", "nope"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test(\"Status is 404\", () => pm.response.to.have.status(404));"]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Create and delete books",
      "item": [
        {
          "name": "Create a book (admin token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-admin-token",
                "value": "{{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Refactoring\",\n  \"author\": \"Martin Fowler\",\n  \"genre\": \"tech\",\n  \"priceCents\": 4200,\n  \"stock\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": ["{{baseUrl}}"],
              "path": ["books"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"bookId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create a book without the token (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Refactoring\",\n  \"author\": \"Martin Fowler\",\n  \"genre\": \"tech\",\n  \"priceCents\": 4200,\n  \"stock\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": ["{{baseUrl}}"],
              "path": ["books"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test(\"Status is 401\", () => pm.response.to.have.status(401));"]
              }
            }
          ]
        },
        {
          "name": "Create a book with a bad body (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-admin-token",
                "value": "{{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"\",\n  \"author\": \"X\",\n  \"genre\": \"tech\",\n  \"priceCents\": -1,\n  \"stock\": 0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": ["{{baseUrl}}"],
              "path": ["books"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test(\"Status is 400\", () => pm.response.to.have.status(400));"]
              }
            }
          ]
        },
        {
          "name": "Delete the created book",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/{{bookId}}",
              "host": ["{{baseUrl}}"],
              "path": ["books", "{{bookId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test(\"Status is 204\", () => pm.response.to.have.status(204));"]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Orders and coupons",
      "item": [
        {
          "name": "Place an order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerEmail\": \"ana@example.com\",\n  \"items\": [\n    {\n      \"bookId\": \"b3\",\n      \"quantity\": 2\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": ["{{baseUrl}}"],
              "path": ["orders"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const o = pm.response.json();",
                  "pm.collectionVariables.set(\"orderId\", o.id);",
                  "pm.test(\"total is 2000 cents\", () => pm.expect(o.totalCents).to.eql(2000));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get the order",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "{{orderId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Order with FIVEOFF (subtotal $20)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerEmail\": \"ana@example.com\",\n  \"items\": [\n    {\n      \"bookId\": \"b3\",\n      \"quantity\": 2\n    }\n  ],\n  \"couponCode\": \"FIVEOFF\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": ["{{baseUrl}}"],
              "path": ["orders"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"total is 1500 cents\", () => pm.expect(pm.response.json().totalCents).to.eql(1500));"
                ]
              }
            }
          ]
        },
        {
          "name": "Order with SAVE10 (TICKET-102: wrong total until fixed)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerEmail\": \"ana@example.com\",\n  \"items\": [\n    {\n      \"bookId\": \"b3\",\n      \"quantity\": 2\n    }\n  ],\n  \"couponCode\": \"SAVE10\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": ["{{baseUrl}}"],
              "path": ["orders"]
            },
            "description": "Subtotal 2000 cents, 10% off. Fails until the discount bug is fixed."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const o = pm.response.json();",
                  "pm.test(\"discount is 200 cents\", () => pm.expect(o.discountCents).to.eql(200));",
                  "pm.test(\"total is 1800 cents\", () => pm.expect(o.totalCents).to.eql(1800));"
                ]
              }
            }
          ]
        },
        {
          "name": "FIVEOFF below the minimum (400)",
