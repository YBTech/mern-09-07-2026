    },
    {
      "name": "4. Tickets (not built yet)",
      "item": [
        {
          "name": "TICKET-101: cancel an order",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "{{orderId}}", "cancel"]
            },
            "description": "Returns 404 until the route exists. Run Place an order first."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "TICKET-103: low-stock report",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reports/low-stock?threshold=5",
              "host": ["{{baseUrl}}"],
              "path": ["reports", "low-stock"],
              "query": [
                {
                  "key": "threshold",
                  "value": "5"
                }
              ]
            },
            "description": "Expected with the seed data: Guns, Germs, and Steel (2), The Hobbit (3), Designing Data-Intensive Applications (4)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"sorted by stock, lowest first\", () => { const s = pm.response.json().map(b => b.stock); pm.expect(s).to.eql([...s].sort((a, b) => a - b)); });"
                ]
              }
            }
          ]
        }
      ],
      "description": "Requests for the lecture tickets. They fail until you build the features."
    }
  ]
}
