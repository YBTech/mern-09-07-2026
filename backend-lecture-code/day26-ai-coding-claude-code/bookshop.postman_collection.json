                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerEmail\": \"ana@example.com\",\n  \"items\": [\n    {\n      \"bookId\": \"nope\",\n      \"quantity\": 1\n    }\n  ]\n}",
