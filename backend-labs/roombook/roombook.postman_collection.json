            "url": {
              "raw": "{{baseUrl}}/bookings",
              "host": ["{{baseUrl}}"],
              "path": ["bookings"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomId\": 6,\n  \"userId\": {{userId}},\n  \"title\": \"Team weekly\",\n  \"start\": \"{{today}}T17:00\",\n  \"end\": \"{{today}}T18:00\",\n  \"repeatWeeks\": 4\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test(\"a series of 4\", () => { pm.expect(b.bookings).to.have.length(4); pm.expect(b.seriesId).to.be.a(\"string\"); });",
                  "pm.collectionVariables.set(\"bookingId\", b.bookings[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "TICKET-2: cancel this and all future bookings",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/bookings/{{bookingId}}?userId={{userId}}&scope=future",
              "host": ["{{baseUrl}}"],
              "path": ["bookings", "{{bookingId}}"],
              "query": [
                {
                  "key": "userId",
                  "value": "{{userId}}"
                },
                {
                  "key": "scope",
                  "value": "future"
                }
              ]
            },
            "description": "Run the weekly series request first."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test(\"Status is 204\", () => pm.response.to.have.status(204));"]
              }
            }
          ]
        },
        {
          "name": "TICKET-2: series with a conflict (409 + conflicts)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bookings",
              "host": ["{{baseUrl}}"],
              "path": ["bookings"]
            },
            "description": "Fir already has a booking tomorrow 14:00-16:00, so the first date clashes and nothing should be saved.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomId\": 6,\n  \"userId\": {{userId}},\n  \"title\": \"Clash with tomorrow's review\",\n  \"start\": \"{{tomorrow}}T14:00\",\n  \"end\": \"{{tomorrow}}T16:00\",\n  \"repeatWeeks\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 409\", () => pm.response.to.have.status(409));",
                  "pm.test(\"lists the clashing dates\", () => pm.expect(pm.response.json().conflicts).to.be.an(\"array\").that.is.not.empty);"
                ]
              }
            }
          ]
        },
