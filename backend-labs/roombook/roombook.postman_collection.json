    {
      "name": "4. TICKET-2 and TICKET-3 (not built yet)",
      "item": [
        {
          "name": "TICKET-2: weekly series, 4 weeks (Fir 17:00-18:00)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
