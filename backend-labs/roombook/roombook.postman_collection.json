        {
          "name": "TICKET-3: find a room for 6 (10:00-11:00)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/rooms/available?date={{today}}&start=10:00&end=11:00&capacity=6",
              "host": ["{{baseUrl}}"],
              "path": ["rooms", "available"],
              "query": [
                {
                  "key": "date",
                  "value": "{{today}}"
                },
                {
                  "key": "start",
                  "value": "10:00"
                },
                {
                  "key": "end",
                  "value": "11:00"
                },
                {
                  "key": "capacity",
                  "value": "6"
                }
              ]
            },
            "description": "Expected: Birch (6), Dogwood (12), Fir (20). Cedar is busy until 11:00 and Aspen seats only 4."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const caps = pm.response.json().map(r => r.capacity);",
                  "pm.test(\"all seat at least 6, smallest first\", () => { pm.expect(caps.every(c => c >= 6)).to.be.true; pm.expect(caps).to.eql([...caps].sort((a, b) => a - b)); });"
                ]
              }
            }
          ]
        },
