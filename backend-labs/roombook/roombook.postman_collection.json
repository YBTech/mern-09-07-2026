              "raw": "{\n  \"roomId\": 5,\n  \"userId\": {{userId}},\n  \"title\": \"Too many weeks\",\n  \"start\": \"{{today}}T12:00\",\n  \"end\": \"{{today}}T13:00\",\n  \"repeatWeeks\": 9\n}",
